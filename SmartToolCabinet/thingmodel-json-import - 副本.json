{
  "properties": [
    {
      "identifier": "account",
      "name": "用户账号",
      "functionType": "u",
      "accessMode": "rw",
      "desc": "系统用户账号列表，逗号分隔",
      "dataType": {
        "type": "string",
        "specs": {
          "length": "256"
        }
      }
    },
    {
      "identifier": "password",
      "name": "用户密码",
      "functionType": "u",
      "accessMode": "rw",
      "desc": "系统用户密码列表，逗号分隔",
      "dataType": {
        "type": "string",
        "specs": {
          "length": "256"
        }
      }
    },
    {
      "identifier": "tool_status",
      "name": "工具状态",
      "functionType": "u",
      "accessMode": "rw",
      "desc": "6个工具的状态位图，每位对应一个工具状态",
      "dataType": {
        "type": "bitMap",
        "specs": {
          "length": 6,
          "define": [
            {
              "bit": 0,
              "0": "螺丝刀在库",
              "1": "螺丝刀借出"
            },
            {
              "bit": 1,
              "0": "钳子在库",
              "1": "钳子借出"
            },
            {
              "bit": 2,
              "0": "扳手在库",
              "1": "扳手借出"
            },
            {
              "bit": 3,
              "0": "锤子在库",
              "1": "锤子借出"
            },
            {
              "bit": 4,
              "0": "卷尺在库",
              "1": "卷尺借出"
            },
            {
              "bit": 5,
              "0": "工具刀在库",
              "1": "工具刀借出"
            }
          ]
        }
      }
    },
    {
      "identifier": "door_status",
      "name": "柜门状态",
      "functionType": "u",
      "accessMode": "r",
      "desc": "柜门的开关状态",
      "dataType": {
        "type": "bool",
        "specs": {
          "true": "开启",
          "false": "关闭"
        }
      }
    },
    {
      "identifier": "alarm_status",
      "name": "报警状态",
      "functionType": "u",
      "accessMode": "r",
      "desc": "系统报警状态",
      "dataType": {
        "type": "bool",
        "specs": {
          "true": "报警中",
          "false": "正常"
        }
      }
    },
    {
      "identifier": "lock_status",
      "name": "电磁锁状态",
      "functionType": "u",
      "accessMode": "r",
      "desc": "电磁锁的开关状态",
      "dataType": {
        "type": "bool",
        "specs": {
          "true": "开启",
          "false": "关闭"
        }
      }
    },
    {
      "identifier": "wifi_signal",
      "name": "WiFi信号强度",
      "functionType": "u",
      "accessMode": "r",
      "desc": "WiFi信号强度值",
      "dataType": {
        "type": "int32",
        "specs": {
          "min": "-100",
          "max": "0",
          "unit": "dBm",
          "step": "1"
        }
      }
    },
    {
      "identifier": "system_status",
      "name": "系统状态",
      "functionType": "u",
      "accessMode": "r",
      "desc": "智能工具柜系统状态",
      "dataType": {
        "type": "enum",
        "specs": {
          "0": "初始化中",
          "1": "运行正常",
          "2": "维护模式",
          "3": "离线模式"
        }
      }
    },
    {
      "identifier": "error_code",
      "name": "错误代码",
      "functionType": "u",
      "accessMode": "r",
      "desc": "系统错误代码",
      "dataType": {
        "type": "int32",
        "specs": {
          "min": "0",
          "max": "999",
          "unit": "",
          "step": "1"
        }
      }
    },
    {
      "identifier": "user_count",
      "name": "用户数量",
      "functionType": "u",

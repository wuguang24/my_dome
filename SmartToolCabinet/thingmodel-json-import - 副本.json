        "specs": {
          "min": "0",
          "max": "999",
          "unit": "个",
          "step": "1"
        }
      }
    },
    {
      "identifier": "tool_count",
      "name": "工具数量",
      "functionType": "u",
      "accessMode": "r",
      "desc": "当前系统中管理的工具总数",
      "dataType": {
        "type": "int32",
        "specs": {
          "min": "0",
          "max": "999",
          "unit": "个",
          "step": "1"
        }
      }
